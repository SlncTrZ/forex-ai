[Unit]
Description=Forex-AI operational health check
After=forex-ai-observe.service

[Service]
Type=oneshot
Environment=FOREX_AI_CONFIG_DIR=%h/.config/forex-ai
EnvironmentFile=-%h/.config/forex-ai/execution.env
ExecStart=%h/.venvs/forex-ai-runtime/bin/python %h/apps/forex-ai/current/scripts/ops_health.py
